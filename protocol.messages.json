              }
            }
          },
          "then": {
            "required": [
              "sender_player_id"
            ]
          }
        }
      ]
    },
    "RESYNC_SNAPSHOT": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "match_id",
        "snapshot_id",
        "snapshot_tick",
        "chunk_index",
        "chunk_count",
        "is_last_chunk",
        "encoding",
        "data_base64",
        "state_hash",
        "post_snapshot_bundle_start_tick"
