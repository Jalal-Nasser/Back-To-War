  "x-messageMeta": {
    "HELLO": {
      "direction": "bidirectional",
      "reliability": "reliable",
      "validation_rules": [
        "protocol_version must equal 1",
        "resume_token must be valid for reconnect if provided"
      ]
    },
    "JOIN_LOBBY": {
      "direction": "client_to_server",
      "reliability": "reliable",
      "validation_rules": [
        "lobby must exist and be open",
        "requested_role spectator cannot occupy player slot"
      ]
    },
    "LOBBY_STATE": {
      "direction": "server_to_client",
      "reliability": "reliable",
      "validation_rules": [
        "revision must be monotonically increasing",
        "lobby_config must validate against lobby-match.schema.json"
      ]
    },
    "SET_ALLIANCE": {
      "direction": "client_to_server",
      "reliability": "reliable",
      "validation_rules": [
        "a_player_id and b_player_id must be different valid seats",
        "scope=match requires allow_in_game_diplomacy=true",
        "non-ally relations must clear shared flags"
      ]
    },
    "READY": {
      "direction": "client_to_server",
      "reliability": "reliable",
      "validation_rules": [
        "sender must control the declared player_id",
        "revision_seen must be valid for lobby state transition"
      ]
    },
    "START_MATCH": {
      "direction": "bidirectional",
      "reliability": "reliable",
      "validation_rules": [
        "request phase allowed only by authorized starter",
        "announce phase must include schema-valid MatchConfig"
      ]
    },
    "CLIENT_COMMANDS": {
      "direction": "client_to_server",
      "reliability": "unreliable_redundant",
      "validation_rules": [
        "target_tick must satisfy target_tick >= server_tick + input_delay_ticks",
        "dedupe key is (sender_player_id,target_tick,command_id)",
        "entity_ids must be sorted ascending and unique"
      ]
    },
    "SERVER_TICK_BUNDLE": {
      "direction": "server_to_client",
      "reliability": "reliable_ack_resend",
      "validation_rules": [
        "bundle_tick must be contiguous",
        "player_inputs must contain exactly one entry per active player",
        "system diplomacy events must be sorted by event_id for same apply_tick"
      ]
    },
    "DESYNC_HASH": {
      "direction": "client_to_server",
      "reliability": "unreliable_periodic",
      "validation_rules": [
        "hash format must be valid hex",
        "sender_role=player requires sender_player_id"
      ]
    },
    "RESYNC_REQUEST": {
      "direction": "client_to_server",
      "reliability": "reliable",
      "validation_rules": [
        "reason must be valid enum",
        "sender_role=player requires sender_player_id"
      ]
    },
    "RESYNC_SNAPSHOT": {
      "direction": "server_to_client",
      "reliability": "reliable",
      "validation_rules": [
        "chunks are assembled by (snapshot_id,chunk_index)",
        "state_hash must match reconstructed snapshot"
      ]
    }
  }
